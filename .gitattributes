# Qator oxirlarini avtomatik normallashtirish
* text=auto

# ===== Matnli fayllar =====
*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.cginc     text
*.compute   text
*.json      text
*.xml       text
*.md        text
*.txt       text
*.asmdef    text
*.asmref    text
*.uss       text
*.uxml      text
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.sh        text eol=lf

